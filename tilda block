<script src="https://unpkg.com/colorthief@2.3.2/dist/color-thief.umd.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/heic-to@1.3.0/dist/iife/heic-to.js"></script>
    <style>
        #palette-widget * {
            box-sizing: border-box;
            font-family: 'Namu', Arial, sans-serif;

        }

        #palette-widget {
            max-width: 960px;
            margin: 0 auto;
            padding: 48px 20px;
            color: #111;
            padding-top: 20px;
        }

        #palette-widget h1 {
            font-size: 40px;
            line-height: 1.2;
            font-weight: 600;
            margin-bottom: 12px;
        }

        #palette-widget p {
            font-size: 18px;
            line-height: 1.4;
            color: #444;
            margin-bottom: 32px;
        }

        /* === Карточка === */
        #palette-widget .card {
            background: #fff;
            border-radius: 16px;
            padding: 40px;
            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.06);
        }

        /* === Drop zone === */
        #palette-widget #dropZone {
            border: 2px dashed #bbb;
            border-radius: 12px;
            padding: 48px 24px;
            text-align: center;
            transition: border-color 0.2s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        #palette-widget #dropZone:hover {
            border-color: #FACAB2;
        }

        #palette-widget input[type="file"] {
            display: none;
        }

        #palette-widget .upload-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 28px;
            background: #000;
            color: #fff;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            border: none;
        }

        #palette-widget .upload-btn:hover {
            opacity: 0.9;
        }

        /* === Подписи === */
        #palette-widget .hint {
            margin-top: 14px;
            font-size: 14px;
            color: #666;
        }

        /* === Превью === */
        #palette-widget #preview {
            display: block;
            max-width: 100%;
            margin: 32px auto 24px;
            border-radius: 12px;
        }

        /* === Палитра === */
        #palette-widget #palette {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin-top: 24px;
        }

        /* === Цвет === */
        #palette-widget #palette div {
            height: 56px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            user-select: none;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        #palette-widget #palette div:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
        }

        /* === Кнопки === */
        #palette-widget button {
            padding: 12px 20px;
            border-radius: 10px;
            border: 1px solid #ddd;
            background: #fff;
            font-size: 15px;
            cursor: pointer;
        }

        #palette-widget button:hover {
            background: #f5f5f5;
        }

        /* === Сообщения === */
        #palette-widget #message {
            margin-top: 16px;
            font-size: 20px;
            color: #b41b1b;
        }

        #palette-widget .dropzone-btn {
            display: inline-block;
            background: #E95927;
            color: #fff;
            border-radius: 8px;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            margin-bottom: 32px;
        }

        .palette-widget__buttons {
            display: none;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 16px;

            button {
                flex: 1 1 auto;
            }
        }

        .palette-widget__copy {
            margin-top: 24px;
            display: none;
        }

        /* === Мобилка === */
        @media (max-width: 640px) {
            #palette-widget h1 {
                font-size: 28px;
            }

            #palette-widget #palette {
                grid-template-columns: repeat(2, 1fr);
            }

            #palette-widget .card {
                padding: 24px;
            }
        }
    </style>
    

    <div id="palette-widget" class="palette-widget">

        <input type="file" id="fileInput" accept="image/*" />

        <label class="dropZone" id="dropZone" for="fileInput">

            <div class="dropzone-content">

                <span type="button" class="dropzone-btn">
                    Загрузить изображение
                </span>

                <div class="dropzone-text">
                    Или перетащите изображение сюда
                </div>

            </div>

        </label>


        <div>
            <img id="preview" alt="Preview" />
        </div>

        <div id="palette"></div>

        <p class="palette-widget__copy">
            Клик по цвету копирует HEX.
        </p>

        <div class="palette-widget__buttons">
            <button id="downloadBtn">Скачать изображение с палитрой</button>
            <button id="downloadSecondBtn">Скачать палитру</button>
            <button id="replaceBtn">Заменить изображение</button>
        </div>

        <div id="message"></div>

    </div>

     <script>
        (() => {
            const MAX_FILE_SIZE = 10 * 1024 * 1024;
            const MAX_ANALYZE_SIZE = 1000;
            const COLORS_COUNT = 10;

            const widget = document.getElementById('palette-widget');
            const fileInput = document.getElementById('fileInput');
            const dropZone = document.getElementById('dropZone');
            const preview = document.getElementById('preview');
            const paletteEl = document.getElementById('palette');
            const downloadBtn = document.getElementById('downloadBtn');
            const downloadSecondBtn = document.getElementById('downloadSecondBtn');
            const replaceBtn = document.getElementById('replaceBtn');
            const messageEl = document.getElementById('message');

            const colorThief = new ColorThief();

            let originalImage = null;
            let paletteColors = [];

            async function isHeicFile(file) {
                try {
                    return await HeicTo.isHeic(file);
                } catch (e) {
                    return false;
                }
            }

            async function convertHeicToImage(file) {
                const result = await HeicTo({
                    blob: file,
                    type: "image/jpeg",
                    quality: 0.8
                });

                return new Promise(resolve => {
                    const img = new Image();
                    img.onload = () => resolve(img);
                    img.src = URL.createObjectURL(result);
                });
            }


            function showMessage(text) {
                messageEl.textContent = text;
            }

            function clearMessage() {
                messageEl.textContent = '';
            }


            function rgbToHex(rgb) {
                return (
                    '#' +
                    rgb
                        .map(v => v.toString(16).padStart(2, '0'))
                        .join('')
                        .toUpperCase()
                );
            }

            function validateFile(file) {
                if (!file) return false;

                if (file.size > MAX_FILE_SIZE) {
                    showMessage('Файл слишком большой (максимум 50 МБ)');
                    return false;
                }

                const isImage =
                    file.type.startsWith('image/') ||
                    file.name.toLowerCase().endsWith('.heic');

                if (!isImage) {
                    showMessage('Неподдерживаемый формат. Попробуйте JPG/PNG/WebP/HEIC');
                    return false;
                }

                return true;
            }


            function resizeForAnalysis(img) {
                const canvas = document.createElement('canvas');
                let { width, height } = img;

                if (Math.max(width, height) > MAX_ANALYZE_SIZE) {
                    const scale = MAX_ANALYZE_SIZE / Math.max(width, height);
                    width = Math.round(width * scale);
                    height = Math.round(height * scale);
                }

                canvas.width = width;
                canvas.height = height;

                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);

                const resized = new Image();
                resized.src = canvas.toDataURL('image/png');
                return resized;
            }

            function renderPalette(colors) {
                paletteEl.innerHTML = '';
                paletteColors = colors;

                colors.forEach(hex => {
                    const item = document.createElement('div');

                    item.textContent = hex;
                    item.dataset.hex = hex;

                    item.style.backgroundColor = hex;
                    item.style.color = getContrastColor(hex);

                    item.addEventListener('click', (e) => {
                        e.stopPropagation();

                        resetPaletteTexts();

                        navigator.clipboard.writeText(hex);
                        item.textContent = 'Скопировано';
                    });

                    paletteEl.appendChild(item);
                });
            }

            function resetPaletteTexts() {
                const items = paletteEl.querySelectorAll('div');

                items.forEach(item => {
                    item.textContent = item.dataset.hex;
                });
            }

            document.addEventListener('click', (e) => {
                if (!e.target.closest('#palette div')) {
                    resetPaletteTexts();
                }
            });


            function getContrastColor(hex) {
                const r = parseInt(hex.substr(1, 2), 16);
                const g = parseInt(hex.substr(3, 2), 16);
                const b = parseInt(hex.substr(5, 2), 16);

                const brightness = (r * 299 + g * 587 + b * 114) / 1000;
                return brightness > 160 ? '#000' : '#fff';
            }


            function extractPalette(img) {
                const resized = resizeForAnalysis(img);

                resized.onload = () => {
                    try {
                        const palette = colorThief.getPalette(resized, COLORS_COUNT);
                        const hexPalette = palette.map(rgbToHex);
                        renderPalette(hexPalette);
                    } catch (e) {
                        showMessage('Не удалось извлечь палитру');
                    }
                };
            }

            async function handleFile(file) {
                clearMessage();
                if (!validateFile(file)) return;

                if (await isHeicFile(file)) {
                    showMessage('Конвертация HEIC…');

                    try {
                        const img = await convertHeicToImage(file);

                        originalImage = img;
                        preview.src = img.src;

                        document.querySelector('.palette-widget__buttons').style.display = 'flex';
                        document.querySelector('.dropZone').style.display = 'none';
                        document.querySelector('.palette-widget__copy').style.display = 'block';

                        extractPalette(img);
                        clearMessage();
                    } catch (e) {
                        console.error(e);
                        showMessage('Не удалось конвертировать HEIC');
                    }

                    return;
                }

                // обычная логика для JPG/PNG
                const reader = new FileReader();
                reader.onload = () => {
                    const img = new Image();
                    img.crossOrigin = 'anonymous';
                    img.onload = () => {
                        originalImage = img;
                        preview.src = img.src;

                        document.querySelector('.palette-widget__buttons').style.display = 'flex';
                        document.querySelector('.dropZone').style.display = 'none';
                        document.querySelector('.palette-widget__copy').style.display = 'block';

                        extractPalette(img);
                    };
                    img.onerror = () => showMessage('Не удалось прочитать изображение');
                    img.src = reader.result;
                };
                reader.readAsDataURL(file);
            }



            fileInput.addEventListener('change', e => {
                handleFile(e.target.files[0]);
                fileInput.value = '';
            });

            replaceBtn.addEventListener('click', () => {
                clearMessage();
                fileInput.click();
            });


            dropZone.addEventListener('dragover', e => {
                e.preventDefault();
            });

            dropZone.addEventListener('drop', e => {
                e.preventDefault();
                handleFile(e.dataTransfer.files[0]);
            });

            // Helper function for safe download on mobile devices
            function triggerDownload(canvas, filename) {
                canvas.toBlob((blob) => {
                    const url = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = filename;
                    link.style.display = 'none';
                    
                    document.body.appendChild(link);
                    
                    // Use setTimeout to ensure the link is in DOM before clicking
                    setTimeout(() => {
                        link.click();
                        
                        // Clean up after download starts
                        setTimeout(() => {
                            document.body.removeChild(link);
                            URL.revokeObjectURL(url);
                        }, 1000);
                    }, 100);
                }, 'image/png');
            }

            downloadBtn.addEventListener('click', () => {
                if (!originalImage || !paletteColors.length) return;

                const SCALE = 2;

                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');

                const padding = 40;
                const swatchHeight = 80;
                const rows = 2;
                const cols = 5;

                const imgWidth = originalImage.width;
                const imgHeight = originalImage.height;

                canvas.width = imgWidth * SCALE;
                canvas.height = (imgHeight + padding + swatchHeight * rows) * SCALE;

                ctx.scale(SCALE, SCALE);

                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.drawImage(originalImage, 0, 0);

                ctx.fillStyle = '#000000';
                ctx.font = '16px sans-serif';
                ctx.fillText(
                    'Сгенерировано на diskill.ru',
                    10,
                    imgHeight + 25
                );

                paletteColors.forEach((hex, i) => {
                    const col = i % cols;
                    const row = Math.floor(i / cols);

                    const x = col * (imgWidth / cols);
                    const y = imgHeight + padding + row * swatchHeight;

                    ctx.fillStyle = hex;
                    ctx.fillRect(
                        x,
                        y,
                        imgWidth / cols,
                        swatchHeight
                    );

                    ctx.fillStyle = '#000000';
                    ctx.fillText(hex, x + 10, y + 30);
                });

                triggerDownload(canvas, 'palette-with-image.png');
            });


            downloadSecondBtn.addEventListener('click', () => {
                if (!paletteColors.length) return;

                const SCALE = 2;

                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');

                const padding = 40;
                const swatchHeight = 80;
                const rows = 2;
                const cols = 5;

                const imgWidth = 500;
                const imgHeight = 0;

                canvas.width = imgWidth * SCALE;
                canvas.height = (imgHeight + padding + swatchHeight * rows) * SCALE;

                ctx.scale(SCALE, SCALE);

                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = '#000000';
                ctx.font = '16px sans-serif';
                ctx.fillText(
                    'Сгенерировано на diskill.ru',
                    10,
                    imgHeight + 25
                );

                paletteColors.forEach((hex, i) => {
                    const col = i % cols;
                    const row = Math.floor(i / cols);

                    const x = col * (imgWidth / cols);
                    const y = imgHeight + padding + row * swatchHeight;

                    ctx.fillStyle = hex;
                    ctx.fillRect(
                        x,
                        y,
                        imgWidth / cols,
                        swatchHeight
                    );

                    ctx.fillStyle = '#000000';
                    ctx.fillText(hex, x + 10, y + 30);
                });

                triggerDownload(canvas, 'palette-only.png');
            });

        })();
    </script>
